APP_NAME=Sistema Inteligente de Atencion al Cliente
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./customer_service.db
JWT_SECRET_KEY=change-this-value-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MODEL_ARTIFACTS_DIR=artifacts/models
LOG_LEVEL=INFO
